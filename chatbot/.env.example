# 이 파일을 .env로 복사해 값을 채우세요. .env는 git에 올라가지 않습니다.

# OpenAI (답변 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upstage (임베딩: 문서는 embedding-passage, 질문은 embedding-query, 4096차원)
UPSTAGE_API_KEY=
UPSTAGE_EMBEDDING_MODEL=embedding

# Supabase (pgvector). Project Settings > API의 URL과 service_role 키. service_role 키는 서버에서만 쓰세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
