{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "build-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "hosting-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "%APPDATA%\\npm\\firebase.cmd", "serve", "--only", "hosting", "--port", "5000"],
      "port": 5000
    },
    {
      "name": "chatbot",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd chatbot && .venv\\Scripts\\streamlit.exe run app.py --server.port 8501 --server.headless true"],
      "port": 8501
    },
    {
      "name": "functions-emulator",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PYTHONUTF8=1&& node scripts/sync-chatbot.mjs && %APPDATA%\\npm\\firebase.cmd emulators:start --only functions"],
      "port": 5001
    },
    {
      "name": "chatbot-8502",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd chatbot && .venv\\Scripts\\streamlit.exe run app.py --server.port 8502 --server.headless true"],
      "port": 8502
    }
  ]
}
